{
  "name": "personal-blog",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.9.0",
    "npm": ">=11.4.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/optimize-images.js && next build && node scripts/generate-feeds.js",
