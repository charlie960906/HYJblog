    "export": "npm run build && next export",
    "build:pages": "npm run export && node scripts/export-to-docs.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "animejs": "4.5.0",
    "feed": "5.2.1",
    "highlight.js": "11.12.0",
    "liquid-gooey": "0.2.2",
    "lucide-react": "1.18.0",
    "marked": "18.0.5",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "5.7.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  },
  "allowScripts": {
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true
